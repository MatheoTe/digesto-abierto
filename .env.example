# --- Base de datos -------------------------------------------------------------
# Postgres 17 con pgvector y unaccent. Con Docker: docker compose up -d
DATABASE_URL=postgres://digesto:digesto@localhost:5432/digesto
# Neon / PgBouncer: DATABASE_URL es la URL con pooling; las migraciones usan la directa si está.
# DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.region.aws.neon.tech/digesto?sslmode=require

# --- Proveedores (opcionales) --------------------------------------------------
# Sin claves funciona offline: vectores locales por n-gramas y respuestas extractivas.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# auto | anthropic | offline
DIGESTO_LLM_PROVIDER=auto
# auto | voyage | local
DIGESTO_EMBEDDINGS_PROVIDER=auto
# auto | voyage | none
DIGESTO_RERANKER=auto

DIGESTO_ANSWER_MODEL=claude-sonnet-5-5
DIGESTO_FAST_MODEL=claude-haiku-4-5-20251001
# low | medium | high
DIGESTO_ANSWER_EFFORT=low
DIGESTO_VOYAGE_EMBED_MODEL=voyage-4
DIGESTO_VOYAGE_RERANK_MODEL=rerank-3

# Fragmentos que recibe el modelo por pregunta
DIGESTO_RETRIEVAL_K=8

# --- Límites del sitio público ---------------------------------------------------
# Preguntas por persona por minuto
DIGESTO_RATE_LIMIT_PER_MINUTE=6
# Tope de gasto en US$ por día (hora de Buenos Aires); 0 = sin tope
DIGESTO_DAILY_BUDGET_USD=2
